# Keep example folders, but do not commit user data by default.
examples/inputs/*
examples/outputs/*
!examples/inputs/.gitkeep
!examples/outputs/.gitkeep

# External repositories are documented, not vendored.
external/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
