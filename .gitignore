# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
.uv-cache/

# Node / frontend
node_modules/
dist/
build/
.vite/

# Local configuration
.env
.env.*
!.env.example
*.local

# Large model artifacts
checkpoints/
weights/
models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
